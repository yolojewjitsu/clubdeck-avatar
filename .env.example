# Node's --env-file does not expand $HOME. This script expands a leading ~/.
# Change this path if your Clubdeck profile is stored elsewhere.
CLUBDECK_PROFILE_PATH="~/Library/Application Support/Clubdeck/profile.json"

# Optional: used when no image argument is provided.
CLUBDECK_IMAGE_PATH=
# Receipts and prepared images persist here for verification/recovery.
CLUBDECK_OUTPUT_DIR="~/.local/state/clubdeck-avatar"
CLUBDECK_FFMPEG_BIN=ffmpeg

# contain: keep the whole image on a blurred square background.
# cover: fill the square with a central crop.
CLUBDECK_CROP_MODE=contain

# These client identifiers worked on 2026-10-10; they are not auto-updated.
CLUBHOUSE_APP_VERSION=26.09.16
CLUBHOUSE_APP_BUILD=1038456
CLUBHOUSE_DEVICE_MANUFACTURER=Google
CLUBHOUSE_DEVICE_MODEL="Pixel 9"
CLUBHOUSE_COUNTRY=US
CLUBDECK_REQUEST_TIMEOUT_MS=35000
CLUBDECK_VERIFY_ATTEMPTS=6
CLUBDECK_VERIFY_DELAY_MS=3000

# Optional credentials instead of a Clubdeck profile file.
# All three are required together. Never commit a populated .env file.
# CLUBHOUSE_TOKEN=
# CLUBHOUSE_USER_ID=
# CLUBHOUSE_DEVICE_ID=
